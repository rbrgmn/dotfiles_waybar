{
  "sway/workspaces": {
    "disable-scroll": true,
    "disable-click": true,
    "all-outputs": true,
    "format": "{index}"
  },
  "privacy": {
    "icon-size": 16,
    "tooltip": false,
  },
  "sway/language": {
    "tooltip": false,
    "format": "<span>{short}</span>",
  },
  "network": {
    "tooltip": false,
    "format-wifi": "NET {essid}",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "NET Disconnected"
  },
  "pulseaudio": {
    "tooltip": false,
    "format": "VOL {volume}%",
    "format-muted": "VOL Mut",
    "format-icons": {
      "headset": "Vol Head",
      "default": "VOL"
    },
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.2 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "clock": {
    "interval": 10,
    "tooltip": false,
    "format": "{:%I:%M %p}",
  },
  "backlight": {
    "tooltip": false,
    "format": "BL {percent}%",
  },
  "cpu": {
    "interval": 5,
    "tooltip": false,
    "format": "CPU {usage:02d}%",
    "min-length": 2,
  },
  "battery": {
    "interval": 5,
    "tooltip": false,
    "states": {
      "warning": 30,
      "critical": 10
    },
    "format": "BAT {capacity}%",
    "format-time": "{H}h {M:02d}m",
    "format-charging": "BAT {capacity}%",
    "format-discharging": "BAT {capacity}%",
    "format-full": "BAT {capacity}% full"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 5
  },
  "custom/vpn": {
    "interval": 10,
    "format": "{}",
    "exec": "nmcli con show --active | grep -qE tun* && echo 'VPN Connected' || echo ''",
    "max-length": "100"
  },
}
