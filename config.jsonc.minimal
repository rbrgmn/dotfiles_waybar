[
  {
    "output": "eDP-1",
    "height": 35,
    "spacing": 0,
    "include": [
      "~/.config/waybar/waybar.d/default-modules.json",
    ],
    "modules-left": [
      "clock",
    ],
    "modules-center": [
      "sway/workspaces"
    ],
    "modules-right": [
      "sway/language",
      "pulseaudio",
      "pulseaudio#microphone",
      "cpu",
      "memory",
      "battery",
      "tray"
    ]
  },
  {
    "output": "HDMI-A-1",
    "include": [
      "~/.config/waybar/waybar.d/default-modules.json"
    ],
    "modules-left": [
      "clock",
    ],
    "modules-center": [
      "sway/workspaces"
    ],
    "modules-right": [
      "sway/language",
      "pulseaudio",
      "pulseaudio#microphone",
      "cpu",
      "memory",
      "battery",
      "tray"
    ]
  }
]
